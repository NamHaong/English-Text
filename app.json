{
  "expo": {
    "name": "Eng Text",
    "slug": "eng-text",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "englishisland",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.englishisland.app",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.englishisland.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-router"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "hoangnam68s-team",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/0877942c-c00a-48b7-b267-3be6d77c65d8",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "extra": {
      "eas": {
        "projectId": "0877942c-c00a-48b7-b267-3be6d77c65d8"
      }
    }
  }
}
